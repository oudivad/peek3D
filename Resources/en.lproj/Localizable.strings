/* Peek3D — base language. The French translation lives in fr.lproj.
   Keep these short. Everything here is read in passing, in a panel or an
   alert someone wants to dismiss. */

/* Shown in place of a preview */
"error.unreadable"      = "Can't read this file: %@";
"error.malformed"       = "Malformed file: %@";
"error.unsupported"     = "Unsupported format: %@";
"error.empty"           = "This file contains no geometry.";

/* Info strip under the preview. %1$@ is STEP or IGES, %2$d a face count. */
"format.cad.faces"      = "%1$@ — %2$d faces";
"info.triangles"        = "%@ triangles";

/* Menus */
"menu.about"            = "About Peek3D";
"menu.handover"         = "Use Peek3D for STL, OBJ and PLY";
"menu.hide"             = "Hide Peek3D";
"menu.quit"             = "Quit Peek3D";
"menu.window"           = "Window";
"menu.close"            = "Close";
"menu.minimize"         = "Minimize";
"about.body"            = "3D previews in the Finder.\n\nFormats: %1$@\nCAD: OpenCASCADE %2$@";

/* Status panel */
"status.heading"        = "Peek3D is installed";
"status.hint"           = "Select a 3D file in the Finder and press Space.";
"status.formats"        = "Formats";
"status.settings"       = "Settings";
"status.quicklook.help" = "macOS previews these three itself and gets priority. Check to hand them to Peek3D — USD and USDZ previews get simpler in exchange.";

/* Asked once, at first launch */
"handover.title"        = "Use Peek3D for STL, OBJ and PLY?";
"handover.body"         = "macOS previews these three itself and gets priority. Hand them to Peek3D instead? USD and USDZ previews get simpler in exchange — you can switch back from the Peek3D menu.";
"handover.accept"       = "Use Peek3D";
"handover.decline"      = "Keep macOS";
"handover.failed"       = "Couldn't change the setting";
"handover.failed.body"  = "In Terminal:\n\npluginkit -e %1$@ -i %2$@";
