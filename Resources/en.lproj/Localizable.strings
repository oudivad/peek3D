/* Taking over the formats macOS already previews */
"handover.title"     = "Use Peek3D for every 3D format?";
"handover.body"      = "macOS already previews %1$@ files with its own extension, and that one takes precedence over Peek3D.\n\nPeek3D can take over, at a price: %2$@ files will then be shown by the system's SceneKit extension, which is cruder.\n\nYou can change this at any time from the Peek3D menu.";
"handover.accept"    = "Use Peek3D";
"handover.decline"   = "Keep the macOS defaults";
"handover.failed"    = "The setting could not be applied";
"handover.failed.body" = "This Terminal command does the same thing:\n\npluginkit -e %1$@ -i %2$@";

