<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>Peek3D</string>
    <key>CFBundleIdentifier</key><string>@BUNDLE_ID@</string>
    <key>CFBundleName</key><string>Peek3D</string>
    <key>CFBundleDisplayName</key><string>Peek3D</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@VERSION@</string>
    <key>CFBundleVersion</key><string>@VERSION@</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleSupportedPlatforms</key><array><string>MacOSX</string></array>
    <key>DTPlatformName</key><string>macosx</string>
    <key>DTSDKName</key><string>macosx@MACOS_MIN@</string>
    <key>LSMinimumSystemVersion</key><string>@MACOS_MIN@</string>
    <key>LSApplicationCategoryType</key><string>public.app-category.graphics-design</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSHumanReadableCopyright</key><string>Peek3D — free software, MIT licence</string>

    <!-- No type declarations here, on purpose. LaunchServices treats whoever
         declares a type as its opener when nobody else claims it, which would
         put a pointless "Open with Peek3D" button on the preview panel — Peek3D
         has no viewer. The declarations live in the Quick Look extension
         instead: an extension is not an application and cannot be offered as an
         opener. -->

    <!-- No CFBundleDocumentTypes: Peek3D does not open documents, it only
         previews them. The type declarations above stay necessary so the Quick
         Look extension knows what it applies to, but nothing here should make
         the application an opener. -->
</dict>
</plist>
